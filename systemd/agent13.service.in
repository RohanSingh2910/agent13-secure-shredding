[Unit]
Description=Agent 13 Secure Shredding Service (OS Lab)
Documentation=file:@LIBDIR@/../../share/doc/agent13/README.md

[Service]
Type=simple
ExecStart=/usr/bin/python3 @LIBDIR@/run_service.py --root %h/agent13-vault --socket %t/agent13/control.sock
Restart=on-failure
RestartSec=2s
RuntimeDirectory=agent13
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
# Complete an in-flight overwrite on SIGTERM; SIGKILL can still interrupt it.
TimeoutStopSec=300s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
