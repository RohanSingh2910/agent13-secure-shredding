#!/usr/bin/python3
import sys
from pathlib import Path

# Works both in a source checkout and under PREFIX/bin with PREFIX/lib/agent13.
prefix = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(prefix / "lib/agent13"))
sys.path.insert(0, str(prefix))
from agent13.cli import main

raise SystemExit(main())
